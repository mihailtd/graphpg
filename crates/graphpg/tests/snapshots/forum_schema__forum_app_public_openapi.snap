    "/rest/messages/aggregate": {
      "get": {
        "summary": "Aggregate messages",
        "description": "Summarises the rows of `messages`: one object of totals, or with `group` one object per group (at most 10000 from at most 4 values), in one scan.",
        "operationId": "aggregate_messages",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            },
            "style": "deepObject",
            "explode": true,
            "description": "Filter criteria, like a list's: `filter[column][operator]=value`"
          },
          {
            "name": "group",
            "in": "query",
            "schema": {
              "type": "array",
              "maxItems": 4,
              "description": "What to group by: a column, `column:unit` (minute, hour, day, week, month, quarter, year) or `column:binned`",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "createdAt:minute",
                  "createdAt:hour",
                  "createdAt:day",
                  "createdAt:week",
