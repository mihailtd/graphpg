    "/rest/users": {
      "get": {
        "summary": "List users",
        "description": "Retrieve rows from `users`",
        "operationId": "list_users",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Filter criteria: `filter[column][operator]=value`, through relations with `filter[relation][column]=value`. Lists take comma-separated values (`filter[id][in]=1,2`). Groups: `filter[or][0][age][lt]=18&filter[or][1][age][gt]=65`, and `filter[not][status][eq]=draft`. Unknown columns and operators are a 400. A body filter (`and` / `or` / `not`, any depth) is `POST …/search`.",
            "schema": {
              "$ref": "#/components/schemas/usersFilter"
            }
          },
          {
            "name": "order",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "What to order by: `column`, `-column` or `column:desc`. Besides the columns: a column of the row a to-one relation leads to (`author.username`), the number of rows of a to-many relation (`messagesCount`) and a computed column that returns an orderable value (`uniqueAuthorCount`); `natural` and `primary_key`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|username|gravatarUrl|createdAt|natural|primary_key|messagesCount)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first",
            "in": "query",
            "description": "Page size for forward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursor to continue after (from the `next` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last",
            "in": "query",
            "description": "Page size for backward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Cursor to continue before (from the `prev` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip (offset pagination)",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: messages, mostRecentForum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages|mostRecentForum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact`, `count=planned`, or `count=estimated` adds `X-Total-Count`; exact costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact",
                "count=planned",
                "count=estimated"
              ]
            }
          },
          {
            "name": "fields[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `messages` (default: all); `include=messages` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "filter[messages]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Keeps only the embedded `messages` rows that match, as `filter` does for a list: `filter[messages][column][operator]=value`. The parents stay; `inner=messages` keeps those with a match",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Order of the embedded `messages` rows: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first[messages]",
            "in": "query",
            "description": "Number of embedded `messages` rows (at most `limits.page_size.max`)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset[messages]",
            "in": "query",
            "description": "Embedded `messages` rows to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields[mostRecentForum]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `mostRecentForum` (default: all); `include=mostRecentForum` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "uniqueAuthorCount"
                ]
              }
            }
          },
          {
            "name": "args[mostRecentForum.uniqueAuthorCount][featured]",
            "in": "query",
            "required": false,
            "description": "Argument `featured` of the computed field `uniqueAuthorCount` of `forums` (select it with `fields=uniqueAuthorCount` or `include=mostRecentForum`)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "inner",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Keeps the rows that have a row through each of these relations (matching its `filter[relation]`), like an inner join. Relations: messages",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "anti",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Keeps the rows that have no row through any of these relations (matching its `filter[relation]`). Relations: messages",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "cursors",
            "in": "query",
            "description": "Each row carries its own cursor in `_cursor`: send it back as `after` / `before` to continue from that row",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "window",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Window values of each row among all the matching rows, in the list's order, pages before this one included: `_window.rowNumber`, `rank`, `denseRank`, `percentRank`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "rowNumber",
                  "rank",
                  "denseRank",
                  "percentRank"
                ]
              }
            }
          },
          {
            "name": "partition",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Number the rows (`window`, `running`) within the groups of rows sharing these values; `column`, `column:unit` for dates",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt",
                  "createdAt:minute",
                  "createdAt:hour",
                  "createdAt:day",
                  "createdAt:week",
                  "createdAt:month",
                  "createdAt:quarter",
                  "createdAt:year",
                  "createdAt:binned"
                ]
              }
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "A page as rows `A` to `B` (`items=0-24`, `items=25-`): answered with `206` and `Content-Range`, or `416` past the end. It does not combine with `first`, `last`, `after`, `before` or `offset`. Another unit or a suffix range is ignored.",
            "schema": {
              "type": "string",
              "pattern": "^items=\\d+-\\d*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of users rows",
            "headers": {
              "Accept-Ranges": {
                "description": "`items`: the list takes `Range: items=A-B`",
                "schema": {
                  "type": "string",
                  "const": "items"
                }
              },
              "Link": {
                "description": "RFC 8288 `next` / `prev` links carrying the cursors",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Number of matching rows; with `Prefer: count=exact`, `count=planned`, or `count=estimated`",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/users"
                  }
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "One row per line"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "206": {
            "description": "Partial Content: the rows of `Range: items=A-B`",
            "headers": {
              "Content-Range": {
                "description": "`items A-B/N`, with `*` for `N` unless `Prefer: count=...` asked for the count",
                "schema": {
                  "type": "string"
                }
              },
              "Link": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/users"
                  }
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "One row per line"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "406": {
            "description": "Not Acceptable: the list is `application/json`, `application/x-ndjson` or `text/csv`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "416": {
            "description": "Range Not Satisfiable: past the end of the list, with its size in `Content-Range: items */N`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create users",
        "description": "Create one row (object body) or, with an array body, up to 1000 rows in one transaction. Nested objects are nested writes, in the shape of the GraphQL input.",
        "operationId": "create_users",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body (default: `return=representation`)",
            "schema": {
              "type": "string",
              "enum": [
                "return=representation",
                "return=minimal"
              ]
            }
          },
          {
            "name": "missing",
            "in": "query",
            "description": "What a column some row of the array sets and another does not becomes in the latter: `default` (the column's default) or `null`",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "null"
              ],
              "default": "default"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/usersCreateInput"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "items": {
                      "$ref": "#/components/schemas/usersCreateInput"
                    }
                  }
                ]
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "description": "Input object for creating a `users` row",
                "properties": {
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "default": "now()"
                  },
                  "gravatarUrl": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "default": "uuid_generate_v1mc()"
                  },
                  "username": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "username"
                ]
              }
            }
          }
        },
        "responses": {
