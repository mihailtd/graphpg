            "const": "CREATED_AT_REQUIRED",
            "description": "`createdAt` is required (it cannot be null)."
          },
          {
            "const": "STALE_VERSION",
            "description": "`expectedVersion` is not the row's `rowVersion`: the row changed since that version was read."
          },
          {
            "const": "ID_TAKEN",
            "description": "A row with this primary key (`id`) already exists."
          },
          {
            "const": "USERNAME_TAKEN",
            "description": "Another row already has this `username` (unique `users_username_key`)."
          },
          {
            "const": "REFERENCED_BY_MESSAGES",
            "description": "`Message` rows still refer to it (`messages_author_id_fkey`)."
          }
        ]
      },
      "usersProblem": {
        "description": "A problem of a write to `users`; its `code` is one of `usersErrorCode` (or one of the general ones)",
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/usersErrorCode"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        ]
      },
      "usersAggregateRequest": {
        "type": "object",
        "description": "Aggregate request for `users`; every member is optional, unknown members are a 400",
        "properties": {
          "filter": {
            "$ref": "#/components/schemas/usersFilter"
          },
          "group": {
            "type": "array",
            "maxItems": 4,
            "description": "What to group by: a column, `column:unit` (minute, hour, day, week, month, quarter, year) or `column:binned`",
            "items": {
              "type": "string",
              "enum": [
                "id",
                "username",
                "gravatarUrl",
                "createdAt",
                "createdAt:minute",
                "createdAt:hour",
                "createdAt:day",
                "createdAt:week",
                "createdAt:month",
                "createdAt:quarter",
                "createdAt:year",
                "createdAt:binned"
              ]
            }
          },
          "min": {
            "type": "array",
            "description": "Columns to take the `min` of",
            "items": {
              "type": "string",
              "enum": [
                "id",
                "username",
                "gravatarUrl",
                "createdAt"
              ]
            }
          },
          "max": {
            "type": "array",
            "description": "Columns to take the `max` of",
            "items": {
              "type": "string",
              "enum": [
                "id",
                "username",
                "gravatarUrl",
                "createdAt"
              ]
            }
          },
          "distinctCount": {
            "type": "array",
            "description": "Columns to take the `distinctCount` of",
            "items": {
              "type": "string",
              "enum": [
                "id",
                "username",
                "gravatarUrl",
                "createdAt"
              ]
            }
          },
          "having": {
            "type": "object",
            "description": "Conditions the groups must meet, all of them: `having[count][gt]=5`, `having[sum][total][gte]=100`",
            "properties": {
              "count": {
                "type": "object",
                "properties": {
                  "equalTo": {
                    "type": "integer"
                  },
                  "notEqualTo": {
                    "type": "integer"
                  },
                  "greaterThan": {
                    "type": "integer"
                  },
                  "greaterThanOrEqualTo": {
                    "type": "integer"
                  },
                  "lessThan": {
                    "type": "integer"
                  },
                  "lessThanOrEqualTo": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              },
              "sum": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "avg": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "min": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "max": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "timeZone": {
            "type": "string",
            "description": "Time zone dates are truncated in, such as `Europe/Paris`"
          },
          "binWidth": {
            "type": "string",
            "description": "Width of `:binned` groups, an ISO 8601 duration such as `PT15M`"
          },
          "binOrigin": {
            "type": "string",
            "format": "date-time",
            "description": "Where `:binned` groups start"
          },
          "fillGaps": {
            "type": "boolean",
            "description": "Include the empty groups between the first and the last"
          }
        },
        "additionalProperties": false
      },
      "usersAggregates": {
        "type": "object",
        "description": "Totals of the filtered rows",
        "properties": {
          "count": {
            "type": "integer",
            "description": "Number of rows"
          },
          "distinctCount": {
            "type": "object",
            "additionalProperties": true,
            "description": "`distinctCount` of each requested column"
          },
          "max": {
            "type": "object",
            "additionalProperties": true,
            "description": "`max` of each requested column"
          },
          "min": {
            "type": "object",
            "additionalProperties": true,
            "description": "`min` of each requested column"
          }
        },
        "additionalProperties": false
      },
      "usersAggregateGroup": {
        "type": "object",
        "description": "One group of rows sharing the `group` values",
        "properties": {
          "keys": {
            "type": "object",
            "additionalProperties": true,
            "description": "The group's values by `group` item"
          },
          "count": {
            "type": "integer"
          },
          "distinctCount": {
            "type": "object",
            "additionalProperties": true,
            "description": "`distinctCount` of each requested column"
          },
          "max": {
            "type": "object",
            "additionalProperties": true,
            "description": "`max` of each requested column"
          },
          "min": {
            "type": "object",
            "additionalProperties": true,
            "description": "`min` of each requested column"
          }
        },
        "additionalProperties": false
      },
