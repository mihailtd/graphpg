          "413": {
            "description": "Content Too Large: the filter matches more rows than `limits.bulk_rows`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Upsert many messages",
        "description": "Insert the rows of the array (at most 1000 rows (`limits.bulk_rows`): above that the write is rolled back with `BULK_LIMIT_EXCEEDED` (413)), and for those whose `conflict` key exists either update them (`resolution=merge`, the default: the columns the rows set, or those of `update`) or leave them (`resolution=ignore`). One statement, one transaction.",
        "operationId": "upsert_many_messages",
        "parameters": [
          {
            "name": "conflict",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "The unique key rows are matched by: its columns, comma-separated (default: the primary key)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                "id"
              ]
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "What happens to a row whose key exists: `merge` updates it, `ignore` leaves it",
            "schema": {
              "type": "string",
              "enum": [
                "merge",
                "ignore"
              ],
              "default": "merge"
            }
          },
          {
            "name": "update",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns a merge updates (default: those the rows set, but the key)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "missing",
            "in": "query",
            "description": "What a column some row of the array sets and another does not becomes in the latter: `default` (the column's default) or `null`",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "null"
              ],
              "default": "default"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body (default: `return=representation`)",
            "schema": {
              "type": "string",
              "enum": [
                "return=representation",
                "return=minimal"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "$ref": "#/components/schemas/messagesCreateInput"
                }
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The rows as they are now (those `ignore` left are the existing ones)",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/messages"
                  }
                }
              }
            }
          },
          "204": {
            "description": "Upserted (`Prefer: return=minimal`)",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/messagesProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a unique constraint other than the `conflict` key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/messagesProblem"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large: more rows than `limits.bulk_rows`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content: a validation failure, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/messagesProblem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "List messages (headers only)",
        "description": "Retrieve rows from `messages`",
        "operationId": "head_messages",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Filter criteria: `filter[column][operator]=value`, through relations with `filter[relation][column]=value`. Lists take comma-separated values (`filter[id][in]=1,2`). Groups: `filter[or][0][age][lt]=18&filter[or][1][age][gt]=65`, and `filter[not][status][eq]=draft`. Unknown columns and operators are a 400. A body filter (`and` / `or` / `not`, any depth) is `POST …/search`.",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "What to order by: `column`, `-column` or `column:desc`. Besides the columns: a column of the row a to-one relation leads to (`author.username`), the number of rows of a to-many relation (`messagesCount`) and a computed column that returns an orderable value (`uniqueAuthorCount`); `natural` and `primary_key`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt|natural|primary_key|author\\.id|author\\.username|author\\.gravatarUrl|author\\.createdAt|user\\.id|user\\.username|user\\.gravatarUrl|user\\.createdAt|forum\\.id|forum\\.name|forum\\.archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first",
            "in": "query",
            "description": "Page size for forward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursor to continue after (from the `next` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last",
            "in": "query",
            "description": "Page size for backward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Cursor to continue before (from the `prev` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip (offset pagination)",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: author, user, forum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact`, `count=planned`, or `count=estimated` adds `X-Total-Count`; exact costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact",
                "count=planned",
                "count=estimated"
              ]
            }
          },
          {
            "name": "fields[author]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `author` (default: all); `include=author` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "fields[user]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `user` (default: all); `include=user` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "fields[forum]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `forum` (default: all); `include=forum` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "uniqueAuthorCount"
                ]
              }
            }
          },
          {
            "name": "args[forum.uniqueAuthorCount][featured]",
            "in": "query",
            "required": false,
            "description": "Argument `featured` of the computed field `uniqueAuthorCount` of `forums` (select it with `fields=uniqueAuthorCount` or `include=forum`)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "inner",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Keeps the rows that have a row through each of these relations (matching its `filter[relation]`), like an inner join. Relations: author, user, forum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "anti",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Keeps the rows that have no row through any of these relations (matching its `filter[relation]`). Relations: author, user, forum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "cursors",
            "in": "query",
            "description": "Each row carries its own cursor in `_cursor`: send it back as `after` / `before` to continue from that row",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "window",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Window values of each row among all the matching rows, in the list's order, pages before this one included: `_window.rowNumber`, `rank`, `denseRank`, `percentRank`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "rowNumber",
                  "rank",
                  "denseRank",
                  "percentRank"
                ]
              }
            }
          },
          {
            "name": "partition",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Number the rows (`window`, `running`) within the groups of rows sharing these values; `column`, `column:unit` for dates",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "createdAt:minute",
                  "createdAt:hour",
                  "createdAt:day",
                  "createdAt:week",
                  "createdAt:month",
                  "createdAt:quarter",
                  "createdAt:year",
                  "createdAt:binned",
                  "archivedAt",
                  "archivedAt:minute",
                  "archivedAt:hour",
                  "archivedAt:day",
                  "archivedAt:week",
                  "archivedAt:month",
                  "archivedAt:quarter",
                  "archivedAt:year",
                  "archivedAt:binned"
                ]
              }
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "A page as rows `A` to `B` (`items=0-24`, `items=25-`): answered with `206` and `Content-Range`, or `416` past the end. It does not combine with `first`, `last`, `after`, `before` or `offset`. Another unit or a suffix range is ignored.",
            "schema": {
              "type": "string",
              "pattern": "^items=\\d+-\\d*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of messages rows",
            "headers": {
              "Accept-Ranges": {
                "description": "`items`: the list takes `Range: items=A-B`",
                "schema": {
                  "type": "string",
                  "const": "items"
                }
              },
              "Link": {
                "description": "RFC 8288 `next` / `prev` links carrying the cursors",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Number of matching rows; with `Prefer: count=exact`, `count=planned`, or `count=estimated`",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "206": {
            "description": "Partial Content: the rows of `Range: items=A-B`",
            "headers": {
              "Content-Range": {
                "description": "`items A-B/N`, with `*` for `N` unless `Prefer: count=...` asked for the count",
                "schema": {
                  "type": "string"
                }
              },
              "Link": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource"
          },
          "406": {
            "description": "Not Acceptable: the list is `application/json`, `application/x-ndjson` or `text/csv`"
          },
          "416": {
            "description": "Range Not Satisfiable: past the end of the list, with its size in `Content-Range: items */N`"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "options": {
        "summary": "Methods and media types",
        "operationId": "options_messages",
        "responses": {
          "204": {
            "description": "The methods allowed",
            "headers": {
              "Allow": {
                "description": "The methods this path answers to",
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Post": {
                "description": "The request media types of a create",
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Patch": {
                "description": "`application/json`, `application/merge-patch+json`",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/rest/messages/search": {
      "post": {
        "summary": "Search messages",
        "description": "The list with the filter and pagination in a JSON body: `and` / `or` / `not`, column operators and relation filters. Continue a paged search by sending the `X-Next-Cursor` / `X-Previous-Cursor` response header back as `after` / `before`.",
        "operationId": "search_messages",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact`, `count=planned`, or `count=estimated` adds `X-Total-Count`; exact costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact",
                "count=planned",
                "count=estimated"
              ]
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/messagesSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results for messages",
            "headers": {
              "X-Total-Count": {
                "description": "With `Prefer: count=exact`, `count=planned`, or `count=estimated`",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "X-Next-Cursor": {
                "description": "Cursor of the next page, if there is one",
                "schema": {
                  "type": "string"
                }
              },
              "X-Previous-Cursor": {
                "description": "Cursor of the previous page, if there is one",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/messages"
                  }
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "One row per line"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "406": {
            "description": "Not Acceptable: the list is `application/json`, `application/x-ndjson` or `text/csv`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/rest/messages/{key}": {
      "get": {
        "summary": "Get messages by key",
        "description": "Retrieve a single row from `messages` by primary key",
        "operationId": "get_messages_by_key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Primary key of `messages` (the Relay global ID of the row is accepted too)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: author, user, forum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "fields[author]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `author` (default: all); `include=author` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "fields[user]",
            "in": "query",
