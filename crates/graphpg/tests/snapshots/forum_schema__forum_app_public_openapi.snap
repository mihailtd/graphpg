    "/import/{type}": {
      "post": {
        "summary": "Import rows",
        "description": "Inserts the rows of the body, one `Create<Type>Input` JSON object per line, checked like any write and streamed into a staging table, then inserted in one statement: in one transaction, so every row is inserted or none.",
        "operationId": "import_rows",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "The GraphQL type of the rows",
            "schema": {
              "type": "string",
              "enum": [
                "Forum",
                "Message",
                "User"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-ndjson": {
              "schema": {
                "type": "string",
                "description": "One row per line, each a `CreateInput` of the type",
                "examples": [
                  [
                    {
                      "$ref": "#/components/schemas/forumsCreateInput"
                    },
                    {
                      "$ref": "#/components/schemas/messagesCreateInput"
                    },
                    {
                      "$ref": "#/components/schemas/usersCreateInput"
                    }
                  ]
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every row was inserted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "inserted": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a unique constraint, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 Problem Details object (`application/problem+json`)",
        "properties": {
          "type": {
            "type": "string",
            "description": "Always `about:blank`; the status and `code` carry the meaning"
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary of the status"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation; raw database messages are masked in production"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference",
            "description": "The request URL"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, such as `EMAIL_TAKEN` or `STALE_VERSION`"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Offending fields or parameters"
          },
          "requestId": {
            "type": "string",
            "description": "Correlates a masked error with the server log"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ]
      },
      "forums": {
        "type": "object",
        "properties": {
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "featuredMessages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/messages"
            },
            "description": "The related `messages` rows; present when embedded with `include=featuredMessages`"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "default": "uuid_generate_v1mc()"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/messages"
            },
            "description": "The related `messages` rows; present when embedded with `include=messages`"
          },
          "name": {
            "type": "string"
          },
          "randomUser": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/users"
              },
              {
                "type": "null"
              }
            ],
            "description": "The related `users` row; present when embedded with `include=randomUser`"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "forumsWithPrevious": {
        "type": "object",
        "description": "The row as it is now and as it was before the write (`Prefer: previous`)",
