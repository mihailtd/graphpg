                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "fields[user]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `user` (default: all); `include=user` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "fields[forum]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `forum` (default: all); `include=forum` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "uniqueAuthorCount"
                ]
              }
            }
          },
          {
            "name": "args[forum.uniqueAuthorCount][featured]",
            "in": "query",
            "required": false,
            "description": "Argument `featured` of the computed field `uniqueAuthorCount` of `forums` (select it with `fields=uniqueAuthorCount` or `include=forum`)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Row version: returns 304 without a body when it matches",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested messages row",
            "headers": {
              "ETag": {
                "description": "Row version",
