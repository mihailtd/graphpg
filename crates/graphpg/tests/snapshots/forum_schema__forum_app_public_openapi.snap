  "paths": {
    "/rest": {
      "get": {
        "summary": "Hello World",
        "description": "REST API liveness / hello-world endpoint",
        "operationId": "getHelloWorld",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/rest/forums": {
      "get": {
        "summary": "List forums",
        "description": "Retrieve rows from `forums`",
        "operationId": "list_forums",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Filter criteria: `filter[column][operator]=value`, through relations with `filter[relation][column]=value`. Unknown columns and operators are a 400. For `and` / `or` / `not` use `POST …/search`.",
            "schema": {
              "$ref": "#/components/schemas/forumsFilter"
            }
          },
          {
            "name": "order",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to order by: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|name|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first",
            "in": "query",
            "description": "Page size for forward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursor to continue after (from the `next` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last",
            "in": "query",
            "description": "Page size for backward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Cursor to continue before (from the `prev` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip (offset pagination)",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: messages",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact` adds `X-Total-Count`; it costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of forums rows",
            "headers": {
              "Link": {
                "description": "RFC 8288 `next` / `prev` links carrying the cursors",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Number of matching rows; only with `Prefer: count=exact`",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/forums"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create forums",
        "description": "Create one row (object body) or, with an array body, up to 1000 rows in one transaction. Nested objects are nested writes, in the shape of the GraphQL input.",
        "operationId": "create_forums",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body (default: `return=representation`)",
            "schema": {
              "type": "string",
              "enum": [
                "return=representation",
                "return=minimal"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/forumsCreateInput"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "items": {
                      "$ref": "#/components/schemas/forumsCreateInput"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created: the row, or an array of rows for a bulk create",
            "headers": {
              "Location": {
                "description": "URL of the created row (single create)",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Row version (single create)",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/forums"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/forums"
                      }
                    }
                  ]
                }
              }
            }
          },
          "204": {
            "description": "Created (`Prefer: return=minimal`)"
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a unique constraint, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large: more rows than a bulk create accepts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content: a validation failure, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/rest/forums/search": {
      "post": {
        "summary": "Search forums",
        "description": "The list with the filter and pagination in a JSON body: `and` / `or` / `not`, column operators and relation filters. Continue a paged search by sending the `X-Next-Cursor` / `X-Previous-Cursor` response header back as `after` / `before`.",
        "operationId": "search_forums",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact` adds `X-Total-Count`; it costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact"
              ]
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/forumsSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results for forums",
            "headers": {
              "X-Total-Count": {
                "description": "Only with `Prefer: count=exact`",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Next-Cursor": {
                "description": "Cursor of the next page, if there is one",
                "schema": {
                  "type": "string"
                }
              },
              "X-Previous-Cursor": {
                "description": "Cursor of the previous page, if there is one",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
