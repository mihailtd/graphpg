    "/rest/users/search": {
      "post": {
        "summary": "Search users",
        "description": "The list with the filter and pagination in a JSON body: `and` / `or` / `not`, column operators and relation filters. Continue a paged search by sending the `X-Next-Cursor` / `X-Previous-Cursor` response header back as `after` / `before`.",
        "operationId": "search_users",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact`, `count=planned`, or `count=estimated` adds `X-Total-Count`; exact costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact",
                "count=planned",
                "count=estimated"
              ]
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/usersSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results for users",
            "headers": {
              "X-Total-Count": {
                "description": "With `Prefer: count=exact`, `count=planned`, or `count=estimated`",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "X-Next-Cursor": {
                "description": "Cursor of the next page, if there is one",
                "schema": {
                  "type": "string"
                }
              },
              "X-Previous-Cursor": {
                "description": "Cursor of the previous page, if there is one",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/users"
                  }
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "One row per line"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "406": {
            "description": "Not Acceptable: the list is `application/json`, `application/x-ndjson` or `text/csv`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/rest/users/{key}": {
      "get": {
        "summary": "Get users by key",
        "description": "Retrieve a single row from `users` by primary key",
        "operationId": "get_users_by_key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Primary key of `users` (the Relay global ID of the row is accepted too)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "by",
            "in": "query",
            "description": "Address the row by this unique key instead of the primary key: the path then holds the key's values, comma-separated in this order",
            "schema": {
              "type": "string",
              "enum": [
                "username"
              ]
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: messages, mostRecentForum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages|mostRecentForum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "fields[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `messages` (default: all); `include=messages` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "filter[messages]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Keeps only the embedded `messages` rows that match, as `filter` does for a list: `filter[messages][column][operator]=value`. The parents stay; `inner=messages` keeps those with a match",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Order of the embedded `messages` rows: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first[messages]",
            "in": "query",
            "description": "Number of embedded `messages` rows (at most `limits.page_size.max`)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset[messages]",
            "in": "query",
            "description": "Embedded `messages` rows to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields[mostRecentForum]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `mostRecentForum` (default: all); `include=mostRecentForum` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "uniqueAuthorCount"
                ]
              }
            }
          },
          {
            "name": "args[mostRecentForum.uniqueAuthorCount][featured]",
            "in": "query",
            "required": false,
            "description": "Argument `featured` of the computed field `uniqueAuthorCount` of `forums` (select it with `fields=uniqueAuthorCount` or `include=mostRecentForum`)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Row version: returns 304 without a body when it matches",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested users row",
            "headers": {
              "ETag": {
                "description": "Row version",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/users"
                }
              }
            },
            "links": {
              "messages": {
                "operationId": "search_messages",
                "description": "The `messages` rows that refer to this `users` (`author_id`)",
                "requestBody": {
                  "filter": {
                    "authorId": {
                      "eq": "$response.body#/id"
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not Modified: the row has not changed since the version in `If-None-Match`",
            "headers": {
              "ETag": {
                "description": "Row version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update users by key",
        "description": "Update the given fields: a JSON body (or an RFC 7396 merge patch: `null` sets a column to NULL), or an RFC 6902 JSON Patch (`application/json-patch+json`) applied to the row as the API shows it (`/title`, `/settings/theme`), answered with 422 `PATCH_FAILED` when an operation does not apply. The key cannot be changed: a key in the body must match the URL.",
        "operationId": "update_users_by_key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Primary key of `users` (the Relay global ID of the row is accepted too)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "by",
            "in": "query",
            "description": "Address the row by this unique key instead of the primary key: the path then holds the key's values, comma-separated in this order",
            "schema": {
              "type": "string",
              "enum": [
                "username"
              ]
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "Row version (the `ETag`) the update must apply to; 412 if the row changed",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body. `previous` answers `{\"row\": …, \"previous\": …}`: the row as it is now and as it was before the write (`null` for a row an upsert inserted); it needs PostgreSQL 18 and is ignored without it.",
            "schema": {
              "type": "string",
              "examples": [
                "return=minimal",
                "previous"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/usersUpdateInput"
              }
            },
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/usersUpdateInput"
              }
            },
            "application/json-patch+json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "op",
                    "path"
                  ],
                  "properties": {
                    "op": {
                      "type": "string",
                      "enum": [
                        "add",
                        "remove",
                        "replace",
                        "move",
                        "copy",
                        "test"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "description": "JSON Pointer into the row: `/title`, `/settings/theme`"
                    },
                    "from": {
                      "type": "string",
                      "description": "JSON Pointer to move or copy from"
                    },
                    "value": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "description": "Input object for creating a `users` row",
                "properties": {
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "default": "now()"
                  },
                  "gravatarUrl": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "default": "uuid_generate_v1mc()"
                  },
                  "username": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "username"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "headers": {
              "ETag": {
                "description": "Row version",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/users"
                    },
                    {
                      "$ref": "#/components/schemas/usersWithPrevious"
                    }
                  ]
                }
              }
            }
          },
          "204": {
            "description": "Done (`Prefer: return=minimal`)"
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/usersProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a constraint, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/usersProblem"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed: the row changed since the `If-Match` version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content: a validation failure, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/usersProblem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
