                    "items": {
                      "type": "string",
                      "pattern": "^(messages|mostRecentForum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A list of rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/users"
                  }
                }
              }
            },
            "headers": {
              "Link": {
                "description": "RFC 8288 `next` / `prev` links (GET)",
                "schema": {
                  "type": "string"
                }
              },
              "X-Next-Cursor": {
                "description": "Cursor of the next page (POST)",
                "schema": {
                  "type": "string"
                }
              },
              "X-Previous-Cursor": {
                "description": "Cursor of the previous page (POST)",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "With `Prefer: count=exact`, `count=planned`, or `count=estimated`",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed argument, parameter, operator or field",
