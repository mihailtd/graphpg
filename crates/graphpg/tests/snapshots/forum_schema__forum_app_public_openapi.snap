      "messagesSearchRequest": {
        "type": "object",
        "description": "Search request for `messages`; every member is optional, unknown members are a 400",
        "properties": {
          "filter": {
            "$ref": "#/components/schemas/messagesFilter"
          },
          "order": {
            "description": "Columns to order by: `column`, `-column` or `column:desc`",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "after": {
            "type": "string",
            "description": "Cursor (the `X-Next-Cursor` header of the previous page)"
          },
          "before": {
            "type": "string",
            "description": "Cursor (the `X-Previous-Cursor` header)"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "id",
                "forumId",
                "authorId",
                "body",
                "featured",
                "createdAt",
                "archivedAt"
              ]
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          },
          "embed": {
            "type": "object",
            "description": "Controls of the embedded relations, by `include` path: the columns, the filter, order and page of its rows",
            "propertyNames": {
              "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "filter": {
                  "type": "object"
                },
                "order": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "first": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "inner": {
            "type": "array",
            "description": "Relations the rows must have a (matching) row through",
            "items": {
              "type": "string",
              "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          },
          "anti": {
            "type": "array",
            "description": "Relations the rows must have no (matching) row through",
            "items": {
              "type": "string",
              "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          }
        },
        "additionalProperties": false
      },
      "messagesErrorCode": {
        "description": "Why a write of `messages` rows can be rejected: the `code` of the 409 and 422 problems",
        "type": "string",
        "oneOf": [
          {
            "const": "ID_REQUIRED",
            "description": "`id` is required (it cannot be null)."
          },
          {
            "const": "FORUM_ID_REQUIRED",
            "description": "`forumId` is required (it cannot be null)."
          },
          {
            "const": "AUTHOR_ID_REQUIRED",
            "description": "`authorId` is required (it cannot be null)."
          },
          {
            "const": "BODY_REQUIRED",
            "description": "`body` is required (it cannot be null)."
          },
          {
            "const": "FEATURED_REQUIRED",
            "description": "`featured` is required (it cannot be null)."
          },
          {
            "const": "CREATED_AT_REQUIRED",
            "description": "`createdAt` is required (it cannot be null)."
          },
          {
            "const": "STALE_VERSION",
            "description": "`expectedVersion` is not the row's `rowVersion`: the row changed since that version was read."
          },
          {
            "const": "ID_TAKEN",
            "description": "A row with this primary key (`id`) already exists."
          },
          {
            "const": "AUTHOR_NOT_FOUND",
            "description": "`authorId` refers to a `User` that does not exist (`messages_author_id_fkey`)."
          },
          {
            "const": "FORUM_NOT_FOUND",
            "description": "`forumId` refers to a `Forum` that does not exist (`messages_forum_id_fkey`)."
          }
        ]
      },
      "messagesProblem": {
        "description": "A problem of a write to `messages`; its `code` is one of `messagesErrorCode` (or one of the general ones)",
        "allOf": [
