            ],
            "items": {
              "$ref": "#/components/schemas/Input.MessageKeyInput"
            },
            "description": "Related `Message` rows to delete (its own children only)."
          },
          "sync": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Input.CreateMessageInput"
            },
            "description": "The related `Message` rows, exactly (its own children only, one `MERGE`): rows whose key matches a child update it, the others are created, and children none matches are deleted. Every row sets the same fields."
          }
        },
        "additionalProperties": false,
        "description": "`Message` rows to relate to, or detach from, the updated row."
      },
