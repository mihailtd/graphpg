{
  "openapi": "3.1.0",
  "info": {
    "title": "graphpg REST API",
    "version": "1.0.0",
    "description": "REST API generated by graphpg from PostgreSQL database metadata"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/rest": {
      "get": {
        "summary": "Hello World",
        "description": "REST API liveness / hello-world endpoint",
        "operationId": "getHelloWorld",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/rest/node/{id}": {
      "get": {
        "summary": "Row by global ID",
        "description": "The row a Relay global ID (the `id` GraphQL gives every row) names: a redirect to the row's own URL, query string kept",
        "operationId": "get_node",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "A Relay global ID: base64 of `<Type>:<key>`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "See Other: the row's URL",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found: no table has that type, or the ID is malformed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/rest/forums": {
      "get": {
        "summary": "List forums",
        "description": "Retrieve rows from `forums`",
        "operationId": "list_forums",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Filter criteria: `filter[column][operator]=value`, through relations with `filter[relation][column]=value`. Lists take comma-separated values (`filter[id][in]=1,2`). Groups: `filter[or][0][age][lt]=18&filter[or][1][age][gt]=65`, and `filter[not][status][eq]=draft`. Unknown columns and operators are a 400. A body filter (`and` / `or` / `not`, any depth) is `POST …/search`.",
            "schema": {
              "$ref": "#/components/schemas/forumsFilter"
            }
          },
          {
            "name": "order",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "What to order by: `column`, `-column` or `column:desc`. Besides the columns: a column of the row a to-one relation leads to (`author.username`), the number of rows of a to-many relation (`messagesCount`) and a computed column that returns an orderable value (`uniqueAuthorCount`); `natural` and `primary_key`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|name|archivedAt|uniqueAuthorCount|natural|primary_key|messagesCount|uniqueAuthorCount)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first",
            "in": "query",
            "description": "Page size for forward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursor to continue after (from the `next` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last",
            "in": "query",
            "description": "Page size for backward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Cursor to continue before (from the `prev` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip (offset pagination)",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "uniqueAuthorCount"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: messages, featuredMessages, randomUser",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages|featuredMessages|randomUser)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact`, `count=planned`, or `count=estimated` adds `X-Total-Count`; exact costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact",
                "count=planned",
                "count=estimated"
              ]
            }
          },
          {
            "name": "fields[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `messages` (default: all); `include=messages` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "filter[messages]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Keeps only the embedded `messages` rows that match, as `filter` does for a list: `filter[messages][column][operator]=value`. The parents stay; `inner=messages` keeps those with a match",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Order of the embedded `messages` rows: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first[messages]",
            "in": "query",
            "description": "Number of embedded `messages` rows (at most `limits.page_size.max`)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset[messages]",
            "in": "query",
            "description": "Embedded `messages` rows to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields[featuredMessages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `featuredMessages` (default: all); `include=featuredMessages` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "filter[featuredMessages]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Keeps only the embedded `featuredMessages` rows that match, as `filter` does for a list: `filter[featuredMessages][column][operator]=value`. The parents stay; `inner=featuredMessages` keeps those with a match",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order[featuredMessages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Order of the embedded `featuredMessages` rows: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first[featuredMessages]",
            "in": "query",
            "description": "Number of embedded `featuredMessages` rows (at most `limits.page_size.max`)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset[featuredMessages]",
            "in": "query",
            "description": "Embedded `featuredMessages` rows to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields[randomUser]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `randomUser` (default: all); `include=randomUser` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "args[uniqueAuthorCount][featured]",
            "in": "query",
            "required": false,
            "description": "Argument `featured` of the computed field `uniqueAuthorCount` of `forums` (select it with `fields=uniqueAuthorCount`)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "inner",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Keeps the rows that have a row through each of these relations (matching its `filter[relation]`), like an inner join. Relations: messages",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "anti",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Keeps the rows that have no row through any of these relations (matching its `filter[relation]`). Relations: messages",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "cursors",
            "in": "query",
            "description": "Each row carries its own cursor in `_cursor`: send it back as `after` / `before` to continue from that row",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "window",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Window values of each row among all the matching rows, in the list's order, pages before this one included: `_window.rowNumber`, `rank`, `denseRank`, `percentRank`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "rowNumber",
                  "rank",
                  "denseRank",
                  "percentRank"
                ]
              }
            }
          },
          {
            "name": "partition",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Number the rows (`window`, `running`) within the groups of rows sharing these values; `column`, `column:unit` for dates",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "archivedAt:minute",
                  "archivedAt:hour",
                  "archivedAt:day",
                  "archivedAt:week",
                  "archivedAt:month",
                  "archivedAt:quarter",
                  "archivedAt:year",
                  "archivedAt:binned"
                ]
              }
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "A page as rows `A` to `B` (`items=0-24`, `items=25-`): answered with `206` and `Content-Range`, or `416` past the end. It does not combine with `first`, `last`, `after`, `before` or `offset`. Another unit or a suffix range is ignored.",
            "schema": {
              "type": "string",
              "pattern": "^items=\\d+-\\d*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of forums rows",
            "headers": {
              "Accept-Ranges": {
                "description": "`items`: the list takes `Range: items=A-B`",
                "schema": {
                  "type": "string",
                  "const": "items"
                }
              },
              "Link": {
                "description": "RFC 8288 `next` / `prev` links carrying the cursors",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Number of matching rows; with `Prefer: count=exact`, `count=planned`, or `count=estimated`",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/forums"
                  }
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "One row per line"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "206": {
            "description": "Partial Content: the rows of `Range: items=A-B`",
            "headers": {
              "Content-Range": {
                "description": "`items A-B/N`, with `*` for `N` unless `Prefer: count=...` asked for the count",
                "schema": {
                  "type": "string"
                }
              },
              "Link": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/forums"
                  }
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "One row per line"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "406": {
            "description": "Not Acceptable: the list is `application/json`, `application/x-ndjson` or `text/csv`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "416": {
            "description": "Range Not Satisfiable: past the end of the list, with its size in `Content-Range: items */N`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create forums",
        "description": "Create one row (object body) or, with an array body, up to 1000 rows in one transaction. Nested objects are nested writes, in the shape of the GraphQL input.",
        "operationId": "create_forums",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body (default: `return=representation`)",
            "schema": {
              "type": "string",
              "enum": [
                "return=representation",
                "return=minimal"
              ]
            }
          },
          {
            "name": "missing",
            "in": "query",
            "description": "What a column some row of the array sets and another does not becomes in the latter: `default` (the column's default) or `null`",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "null"
              ],
              "default": "default"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/forumsCreateInput"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "items": {
                      "$ref": "#/components/schemas/forumsCreateInput"
                    }
                  }
                ]
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "description": "Input object for creating a `forums` row",
                "properties": {
                  "archivedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "default": "uuid_generate_v1mc()"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created: the row, or an array of rows for a bulk create",
            "headers": {
              "Location": {
                "description": "URL of the created row (single create)",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Row version (single create)",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/forums"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/forums"
                      }
                    }
                  ]
                }
              }
            }
          },
          "204": {
            "description": "Created (`Prefer: return=minimal`)"
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a unique constraint, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large: more rows than a bulk create accepts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type: send JSON, CSV rows or `multipart/form-data`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content: a validation failure, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update forums by filter",
        "description": "Set the given columns in every row the `filter` matches, in one statement and one transaction; at most 1000 rows (`limits.bulk_rows`): above that the write is rolled back with `BULK_LIMIT_EXCEEDED` (413). Without a `filter` the write is refused (`FILTER_REQUIRED`) unless `unfiltered=true`. A JSON Patch applies to one row (`PATCH …/{key}`).",
        "operationId": "update_many_forums",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "The rows to write: the filter a list takes, `filter[column][operator]=value`. Required unless `unfiltered=true`",
            "schema": {
              "$ref": "#/components/schemas/forumsFilter"
            }
          },
          {
            "name": "unfiltered",
            "in": "query",
            "description": "Allow the write without a `filter`, which writes every row",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body (default: `return=representation`)",
            "schema": {
              "type": "string",
              "enum": [
                "return=representation",
                "return=minimal"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/forumsUpdateInput"
              }
            },
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/forumsUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated rows",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/forums"
                  }
                }
              }
            }
          },
          "204": {
            "description": "Updated (`Prefer: return=minimal`); `X-Affected-Count` has the count",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a unique constraint, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large: the filter matches more rows than `limits.bulk_rows`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type: send JSON or a merge patch",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content: a validation failure, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete forums by filter",
        "description": "Delete every row the `filter` matches, in one statement and one transaction; at most 1000 rows (`limits.bulk_rows`): above that the write is rolled back with `BULK_LIMIT_EXCEEDED` (413). Without a `filter` the write is refused (`FILTER_REQUIRED`) unless `unfiltered=true`.",
        "operationId": "delete_many_forums",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "The rows to write: the filter a list takes, `filter[column][operator]=value`. Required unless `unfiltered=true`",
            "schema": {
              "$ref": "#/components/schemas/forumsFilter"
            }
          },
          {
            "name": "unfiltered",
            "in": "query",
            "description": "Allow the write without a `filter`, which writes every row",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body (default: `return=representation`)",
            "schema": {
              "type": "string",
              "enum": [
                "return=representation",
                "return=minimal"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The deleted rows",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/forums"
                  }
                }
              }
            }
          },
          "204": {
            "description": "Deleted (`Prefer: return=minimal`); `X-Affected-Count` has the count",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a foreign key still refers to a row",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large: the filter matches more rows than `limits.bulk_rows`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Upsert many forums",
        "description": "Insert the rows of the array (at most 1000 rows (`limits.bulk_rows`): above that the write is rolled back with `BULK_LIMIT_EXCEEDED` (413)), and for those whose `conflict` key exists either update them (`resolution=merge`, the default: the columns the rows set, or those of `update`) or leave them (`resolution=ignore`). One statement, one transaction.",
        "operationId": "upsert_many_forums",
        "parameters": [
          {
            "name": "conflict",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "The unique key rows are matched by: its columns, comma-separated (default: the primary key)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                "id"
              ]
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "What happens to a row whose key exists: `merge` updates it, `ignore` leaves it",
            "schema": {
              "type": "string",
              "enum": [
                "merge",
                "ignore"
              ],
              "default": "merge"
            }
          },
          {
            "name": "update",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns a merge updates (default: those the rows set, but the key)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "missing",
            "in": "query",
            "description": "What a column some row of the array sets and another does not becomes in the latter: `default` (the column's default) or `null`",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "null"
              ],
              "default": "default"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body (default: `return=representation`)",
            "schema": {
              "type": "string",
              "enum": [
                "return=representation",
                "return=minimal"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "$ref": "#/components/schemas/forumsCreateInput"
                }
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The rows as they are now (those `ignore` left are the existing ones)",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/forums"
                  }
                }
              }
            }
          },
          "204": {
            "description": "Upserted (`Prefer: return=minimal`)",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a unique constraint other than the `conflict` key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large: more rows than `limits.bulk_rows`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content: a validation failure, with its typed `code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "List forums (headers only)",
        "description": "Retrieve rows from `forums`",
        "operationId": "head_forums",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Filter criteria: `filter[column][operator]=value`, through relations with `filter[relation][column]=value`. Lists take comma-separated values (`filter[id][in]=1,2`). Groups: `filter[or][0][age][lt]=18&filter[or][1][age][gt]=65`, and `filter[not][status][eq]=draft`. Unknown columns and operators are a 400. A body filter (`and` / `or` / `not`, any depth) is `POST …/search`.",
            "schema": {
              "$ref": "#/components/schemas/forumsFilter"
            }
          },
          {
            "name": "order",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "What to order by: `column`, `-column` or `column:desc`. Besides the columns: a column of the row a to-one relation leads to (`author.username`), the number of rows of a to-many relation (`messagesCount`) and a computed column that returns an orderable value (`uniqueAuthorCount`); `natural` and `primary_key`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|name|archivedAt|uniqueAuthorCount|natural|primary_key|messagesCount|uniqueAuthorCount)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first",
            "in": "query",
            "description": "Page size for forward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursor to continue after (from the `next` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last",
            "in": "query",
            "description": "Page size for backward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Cursor to continue before (from the `prev` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip (offset pagination)",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "uniqueAuthorCount"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: messages, featuredMessages, randomUser",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages|featuredMessages|randomUser)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact`, `count=planned`, or `count=estimated` adds `X-Total-Count`; exact costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact",
                "count=planned",
                "count=estimated"
              ]
            }
          },
          {
            "name": "fields[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `messages` (default: all); `include=messages` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "filter[messages]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Keeps only the embedded `messages` rows that match, as `filter` does for a list: `filter[messages][column][operator]=value`. The parents stay; `inner=messages` keeps those with a match",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Order of the embedded `messages` rows: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first[messages]",
            "in": "query",
            "description": "Number of embedded `messages` rows (at most `limits.page_size.max`)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset[messages]",
            "in": "query",
            "description": "Embedded `messages` rows to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields[featuredMessages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `featuredMessages` (default: all); `include=featuredMessages` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "filter[featuredMessages]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Keeps only the embedded `featuredMessages` rows that match, as `filter` does for a list: `filter[featuredMessages][column][operator]=value`. The parents stay; `inner=featuredMessages` keeps those with a match",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order[featuredMessages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Order of the embedded `featuredMessages` rows: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first[featuredMessages]",
            "in": "query",
            "description": "Number of embedded `featuredMessages` rows (at most `limits.page_size.max`)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset[featuredMessages]",
            "in": "query",
            "description": "Embedded `featuredMessages` rows to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields[randomUser]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `randomUser` (default: all); `include=randomUser` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "args[uniqueAuthorCount][featured]",
            "in": "query",
            "required": false,
            "description": "Argument `featured` of the computed field `uniqueAuthorCount` of `forums` (select it with `fields=uniqueAuthorCount`)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "inner",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Keeps the rows that have a row through each of these relations (matching its `filter[relation]`), like an inner join. Relations: messages",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "anti",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Keeps the rows that have no row through any of these relations (matching its `filter[relation]`). Relations: messages",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "cursors",
            "in": "query",
            "description": "Each row carries its own cursor in `_cursor`: send it back as `after` / `before` to continue from that row",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "window",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Window values of each row among all the matching rows, in the list's order, pages before this one included: `_window.rowNumber`, `rank`, `denseRank`, `percentRank`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "rowNumber",
                  "rank",
                  "denseRank",
                  "percentRank"
                ]
              }
            }
          },
          {
            "name": "partition",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Number the rows (`window`, `running`) within the groups of rows sharing these values; `column`, `column:unit` for dates",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "archivedAt:minute",
                  "archivedAt:hour",
                  "archivedAt:day",
                  "archivedAt:week",
                  "archivedAt:month",
                  "archivedAt:quarter",
                  "archivedAt:year",
                  "archivedAt:binned"
                ]
              }
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "A page as rows `A` to `B` (`items=0-24`, `items=25-`): answered with `206` and `Content-Range`, or `416` past the end. It does not combine with `first`, `last`, `after`, `before` or `offset`. Another unit or a suffix range is ignored.",
            "schema": {
              "type": "string",
              "pattern": "^items=\\d+-\\d*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of forums rows",
            "headers": {
              "Accept-Ranges": {
                "description": "`items`: the list takes `Range: items=A-B`",
                "schema": {
                  "type": "string",
                  "const": "items"
                }
              },
              "Link": {
                "description": "RFC 8288 `next` / `prev` links carrying the cursors",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Number of matching rows; with `Prefer: count=exact`, `count=planned`, or `count=estimated`",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count-Estimate": {
                "description": "`true` if `X-Total-Count` is a planner estimate",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
