                "name",
                "archivedAt",
                "uniqueAuthorCount"
              ]
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(messages|featuredMessages|randomUser)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          },
          "embed": {
            "type": "object",
            "description": "Controls of the embedded relations, by `include` path: the columns, the filter, order and page of its rows",
            "propertyNames": {
              "pattern": "^(messages|featuredMessages|randomUser)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "filter": {
                  "type": "object"
                },
                "order": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "first": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "inner": {
            "type": "array",
            "description": "Relations the rows must have a (matching) row through",
            "items": {
              "type": "string",
              "pattern": "^(messages|featuredMessages|randomUser)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          },
          "anti": {
            "type": "array",
            "description": "Relations the rows must have no (matching) row through",
            "items": {
              "type": "string",
              "pattern": "^(messages|featuredMessages|randomUser)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
