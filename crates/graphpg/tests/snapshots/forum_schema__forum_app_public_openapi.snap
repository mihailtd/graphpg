      "put": {
        "summary": "Upsert many users",
        "description": "Insert the rows of the array (at most 1000 rows (`limits.bulk_rows`): above that the write is rolled back with `BULK_LIMIT_EXCEEDED` (413)), and for those whose `conflict` key exists either update them (`resolution=merge`, the default: the columns the rows set, or those of `update`) or leave them (`resolution=ignore`). One statement, one transaction.",
        "operationId": "upsert_many_users",
        "parameters": [
          {
            "name": "conflict",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "The unique key rows are matched by: its columns, comma-separated (default: the primary key)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                "id",
                "username"
              ]
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "What happens to a row whose key exists: `merge` updates it, `ignore` leaves it",
            "schema": {
              "type": "string",
              "enum": [
                "merge",
                "ignore"
              ],
              "default": "merge"
            }
          },
          {
            "name": "update",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns a merge updates (default: those the rows set, but the key)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "missing",
            "in": "query",
            "description": "What a column some row of the array sets and another does not becomes in the latter: `default` (the column's default) or `null`",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "null"
              ],
              "default": "default"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body (default: `return=representation`)",
            "schema": {
              "type": "string",
              "enum": [
                "return=representation",
                "return=minimal"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "$ref": "#/components/schemas/usersCreateInput"
                }
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The rows as they are now (those `ignore` left are the existing ones)",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/users"
                  }
                }
              }
            }
          },
          "204": {
            "description": "Upserted (`Prefer: return=minimal`)",
            "headers": {
              "X-Affected-Count": {
                "description": "Number of rows written",
                "schema": {
                  "type": "integer"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/usersProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: a unique constraint other than the `conflict` key",
            "content": {
