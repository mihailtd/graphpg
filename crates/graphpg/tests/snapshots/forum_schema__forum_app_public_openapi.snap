      "forumsErrorCode": {
        "description": "Why a write of `forums` rows can be rejected: the `code` of the 409 and 422 problems",
        "type": "string",
        "oneOf": [
          {
            "const": "ID_REQUIRED",
            "description": "`id` is required (it cannot be null)."
          },
          {
            "const": "NAME_REQUIRED",
            "description": "`name` is required (it cannot be null)."
          },
          {
            "const": "STALE_VERSION",
            "description": "`expectedVersion` is not the row's `rowVersion`: the row changed since that version was read."
          },
          {
            "const": "ID_TAKEN",
            "description": "A row with this primary key (`id`) already exists."
          },
          {
            "const": "REFERENCED_BY_MESSAGES",
            "description": "`Message` rows still refer to it (`messages_forum_id_fkey`)."
          }
        ]
      },
