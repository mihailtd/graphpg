      "head": {
        "summary": "Get messages by key (headers only)",
        "description": "Retrieve a single row from `messages` by primary key",
        "operationId": "head_messages_by_key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Primary key of `messages` (the Relay global ID of the row is accepted too)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: author, user, forum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
