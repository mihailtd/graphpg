                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: author, user, forum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested messages row",
            "headers": {
              "ETag": {
                "description": "Row version",
                "schema": {
                  "type": "string"
                }
