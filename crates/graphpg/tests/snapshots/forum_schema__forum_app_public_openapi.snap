    "/rest/rpc/featured_messages": {
      "get": {
        "summary": "Call `featured_messages`",
        "description": "Call `featured_messages`\n\nArguments are query parameters.",
        "operationId": "rpc_featured_messages",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Filter criteria: `filter[column][operator]=value`, through relations with `filter[relation][column]=value`. Unknown columns and operators are a 400. For `and` / `or` / `not` use `POST …/search`.",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to order by: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first",
            "in": "query",
            "description": "Page size for forward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursor to continue after (from the `next` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last",
            "in": "query",
            "description": "Page size for backward keyset pagination (default 100, at most 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Cursor to continue before (from the `prev` link)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip (offset pagination)",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: author, user, forum",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(author|user|forum)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact` adds `X-Total-Count`; it costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact"
              ]
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`count=exact` adds `X-Total-Count`; it costs a scan of every matching row, so it is off by default",
            "schema": {
              "type": "string",
              "enum": [
                "count=exact"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/messages"
                  }
                }
              }
            },
            "headers": {
              "Link": {
                "description": "RFC 8288 `next` / `prev` links (GET)",
                "schema": {
                  "type": "string"
                }
              },
              "X-Next-Cursor": {
                "description": "Cursor of the next page (POST)",
                "schema": {
                  "type": "string"
                }
              },
              "X-Previous-Cursor": {
                "description": "Cursor of the previous page (POST)",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Only with `Prefer: count=exact`",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed argument, parameter, operator or field",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found: no such function",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
