      "patch": {
        "summary": "Update messages by key",
        "description": "Update the given fields: a JSON body (or an RFC 7396 merge patch: `null` sets a column to NULL), or an RFC 6902 JSON Patch (`application/json-patch+json`) applied to the row as the API shows it (`/title`, `/settings/theme`), answered with 422 `PATCH_FAILED` when an operation does not apply. The key cannot be changed: a key in the body must match the URL.",
        "operationId": "update_messages_by_key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Primary key of `messages` (the Relay global ID of the row is accepted too)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "Row version (the `ETag`) the update must apply to; 412 if the row changed",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body. `previous` answers `{\"row\": …, \"previous\": …}`: the row as it is now and as it was before the write (`null` for a row an upsert inserted); it needs PostgreSQL 18 and is ignored without it.",
            "schema": {
              "type": "string",
              "examples": [
                "return=minimal",
                "previous"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/messagesUpdateInput"
              }
            },
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/messagesUpdateInput"
              }
            },
            "application/json-patch+json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "op",
                    "path"
                  ],
                  "properties": {
                    "op": {
                      "type": "string",
                      "enum": [
                        "add",
                        "remove",
                        "replace",
                        "move",
                        "copy",
                        "test"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "description": "JSON Pointer into the row: `/title`, `/settings/theme`"
                    },
                    "from": {
                      "type": "string",
                      "description": "JSON Pointer to move or copy from"
                    },
                    "value": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "description": "Input object for creating a `messages` row",
                "properties": {
                  "archivedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "authorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "body": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "default": "now()"
                  },
                  "featured": {
                    "type": "boolean",
                    "default": "false"
                  },
                  "forumId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "default": "uuid_generate_v1mc()"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "forumId",
                  "authorId",
                  "body"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "headers": {
              "ETag": {
                "description": "Row version",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/messages"
                    },
                    {
                      "$ref": "#/components/schemas/messagesWithPrevious"
                    }
                  ]
                }
              }
            }
          },
          "204": {
            "description": "Done (`Prefer: return=minimal`)"
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/messagesProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
