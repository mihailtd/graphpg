{
  "openapi": "3.1.0",
  "info": {
    "title": "graphpg REST API",
    "version": "1.0.0",
    "description": "REST API generated by graphpg from PostgreSQL database metadata"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
