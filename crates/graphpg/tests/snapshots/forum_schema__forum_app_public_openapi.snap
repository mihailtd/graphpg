    "/rest/forums/{key}": {
      "get": {
        "summary": "Get forums by key",
        "description": "Retrieve a single row from `forums` by primary key",
        "operationId": "get_forums_by_key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Primary key of `forums` (the Relay global ID of the row is accepted too)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns to return (default: all)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "name",
                  "archivedAt",
                  "uniqueAuthorCount"
                ]
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Relations to embed, with nested ones as dotted paths (`posts.author`), as deep as the depth and cost limits allow. Relations: messages, featuredMessages, randomUser",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(messages|featuredMessages|randomUser)(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          {
            "name": "fields[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `messages` (default: all); `include=messages` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "filter[messages]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Keeps only the embedded `messages` rows that match, as `filter` does for a list: `filter[messages][column][operator]=value`. The parents stay; `inner=messages` keeps those with a match",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order[messages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Order of the embedded `messages` rows: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first[messages]",
            "in": "query",
            "description": "Number of embedded `messages` rows (at most `limits.page_size.max`)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset[messages]",
            "in": "query",
            "description": "Embedded `messages` rows to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields[featuredMessages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `featuredMessages` (default: all); `include=featuredMessages` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "forumId",
                  "authorId",
                  "body",
                  "featured",
                  "createdAt",
                  "archivedAt"
                ]
              }
            }
          },
          {
            "name": "filter[featuredMessages]",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Keeps only the embedded `featuredMessages` rows that match, as `filter` does for a list: `filter[featuredMessages][column][operator]=value`. The parents stay; `inner=featuredMessages` keeps those with a match",
            "schema": {
              "$ref": "#/components/schemas/messagesFilter"
            }
          },
          {
            "name": "order[featuredMessages]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Order of the embedded `featuredMessages` rows: `column`, `-column` or `column:desc`",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(id|forumId|authorId|body|featured|createdAt|archivedAt)(:(asc|desc))?$"
              }
            }
          },
          {
            "name": "first[featuredMessages]",
            "in": "query",
            "description": "Number of embedded `featuredMessages` rows (at most `limits.page_size.max`)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset[featuredMessages]",
            "in": "query",
            "description": "Embedded `featuredMessages` rows to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields[randomUser]",
            "in": "query",
            "style": "form",
            "explode": false,
            "description": "Columns of the embedded `randomUser` (default: all); `include=randomUser` first",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "username",
                  "gravatarUrl",
                  "createdAt"
                ]
              }
            }
          },
          {
            "name": "args[uniqueAuthorCount][featured]",
            "in": "query",
            "required": false,
            "description": "Argument `featured` of the computed field `uniqueAuthorCount` of `forums` (select it with `fields=uniqueAuthorCount`)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Row version: returns 304 without a body when it matches",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested forums row",
            "headers": {
              "ETag": {
                "description": "Row version",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/forums"
                }
              }
            },
            "links": {
              "messages": {
                "operationId": "search_messages",
                "description": "The `messages` rows that refer to this `forums` (`forum_id`)",
                "requestBody": {
                  "filter": {
                    "forumId": {
                      "eq": "$response.body#/id"
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not Modified: the row has not changed since the version in `If-None-Match`",
            "headers": {
              "ETag": {
                "description": "Row version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update forums by key",
        "description": "Update the given fields: a JSON body (or an RFC 7396 merge patch: `null` sets a column to NULL), or an RFC 6902 JSON Patch (`application/json-patch+json`) applied to the row as the API shows it (`/title`, `/settings/theme`), answered with 422 `PATCH_FAILED` when an operation does not apply. The key cannot be changed: a key in the body must match the URL.",
        "operationId": "update_forums_by_key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Primary key of `forums` (the Relay global ID of the row is accepted too)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "Row version (the `ETag`) the update must apply to; 412 if the row changed",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "`return=minimal` answers 204 without a body. `previous` answers `{\"row\": …, \"previous\": …}`: the row as it is now and as it was before the write (`null` for a row an upsert inserted); it needs PostgreSQL 18 and is ignored without it.",
            "schema": {
              "type": "string",
              "examples": [
                "return=minimal",
                "previous"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/forumsUpdateInput"
              }
            },
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/forumsUpdateInput"
              }
            },
            "application/json-patch+json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "op",
                    "path"
                  ],
                  "properties": {
                    "op": {
                      "type": "string",
                      "enum": [
                        "add",
                        "remove",
                        "replace",
                        "move",
                        "copy",
                        "test"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "description": "JSON Pointer into the row: `/title`, `/settings/theme`"
                    },
                    "from": {
                      "type": "string",
                      "description": "JSON Pointer to move or copy from"
                    },
                    "value": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "description": "Input object for creating a `forums` row",
                "properties": {
                  "archivedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "default": "uuid_generate_v1mc()"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "headers": {
              "ETag": {
                "description": "Row version",
                "schema": {
                  "type": "string"
                }
              },
              "Preference-Applied": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/forums"
                    },
                    {
                      "$ref": "#/components/schemas/forumsWithPrevious"
                    }
                  ]
                }
              }
            }
          },
          "204": {
            "description": "Done (`Prefer: return=minimal`)"
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/forumsProblem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
