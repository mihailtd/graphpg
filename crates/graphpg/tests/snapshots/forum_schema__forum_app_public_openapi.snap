    "/export": {
      "post": {
        "summary": "Export a connection",
        "description": "Streams every row a GraphQL query's single connection field (its `nodes`) selects, read from a server-side portal in batches, so neither side holds the whole result: for tables of any size, where a list is bounded by `limits.page_size`.",
        "operationId": "export_rows",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "A GraphQL query whose only root field is a connection"
                  },
                  "operationName": {
                    "type": "string"
                  },
                  "variables": {
                    "type": "object"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "ndjson",
                      "csv"
                    ],
                    "default": "ndjson"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The rows, one JSON object per line (or CSV)",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: an unknown or malformed parameter, operator, field or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the operation is not permitted on this resource",
