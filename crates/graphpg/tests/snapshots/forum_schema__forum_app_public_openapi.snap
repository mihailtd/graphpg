              }
            ]
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "after": {
            "type": "string",
