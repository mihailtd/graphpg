type Forum implements Node {
  """The globally unique identifier across all types for Relay compatibility."""
  id: ID!
  """The raw underlying database primary key value."""
  databaseId: UUID!
  name: String!
  archivedAt: Datetime
  """Version of the row, changed by every write of it: pass it as `expectedVersion` to update or delete the row only if it did not change since. Null for a row that is not stored in the table (e.g. one a function built)."""
  rowVersion: String
  messages: [Message!]!
  messagesConnection(first: Int, after: String, last: Int, before: String, offset: Int, condition: MessageCondition, filter: MessageFilter, orderBy: [MessageOrderBy!]): MessageConnection!
  featuredMessages(first: Int, after: String, last: Int, before: String, offset: Int, condition: MessageCondition, filter: MessageFilter, orderBy: [MessageOrderBy!]): MessageConnection!
  randomUser: User
  uniqueAuthorCount(featured: Boolean): Int
}

type Message implements Node {
  """The globally unique identifier across all types for Relay compatibility."""
  id: ID!
  """The raw underlying database primary key value."""
  databaseId: UUID!
  forumId: UUID!
  authorId: UUID!
  body: String!
  featured: Boolean!
  createdAt: Datetime!
  archivedAt: Datetime
  """Version of the row, changed by every write of it: pass it as `expectedVersion` to update or delete the row only if it did not change since. Null for a row that is not stored in the table (e.g. one a function built)."""
  rowVersion: String
  author: User
  user: User
  forum: Forum
}

type User implements Node {
  """The globally unique identifier across all types for Relay compatibility."""
  id: ID!
  """The raw underlying database primary key value."""
  databaseId: UUID!
  username: String!
  gravatarUrl: String
  createdAt: Datetime!
  """Version of the row, changed by every write of it: pass it as `expectedVersion` to update or delete the row only if it did not change since. Null for a row that is not stored in the table (e.g. one a function built)."""
  rowVersion: String
  messages: [Message!]!
  messagesConnection(first: Int, after: String, last: Int, before: String, offset: Int, condition: MessageCondition, filter: MessageFilter, orderBy: [MessageOrderBy!]): MessageConnection!
  mostRecentForum: Forum
}

input ForumCondition {
  id: UUID
  name: String
  archivedAt: Datetime
}

input ForumFilter {
  and: [ForumFilter!]
  or: [ForumFilter!]
  not: ForumFilter
  id: UUIDFilter
  name: StringFilter
  archivedAt: DatetimeFilter
  messages: MessageToManyFilter
}

enum ForumOrderBy {
  NATURAL
  PRIMARY_KEY_ASC
  PRIMARY_KEY_DESC
  ID_ASC
  ID_DESC
  NAME_ASC
  NAME_DESC
  ARCHIVED_AT_ASC
  ARCHIVED_AT_DESC
  """Ascending, NULLs first."""
  ARCHIVED_AT_ASC_NULLS_FIRST
  """Descending, NULLs last."""
  ARCHIVED_AT_DESC_NULLS_LAST
  """By the number of related `Message` rows."""
  MESSAGES_COUNT_ASC
  """By the number of related `Message` rows."""
  MESSAGES_COUNT_DESC
  """By the value of the computed field `uniqueAuthorCount`."""
  UNIQUE_AUTHOR_COUNT_ASC
  """By the value of the computed field `uniqueAuthorCount`."""
  UNIQUE_AUTHOR_COUNT_DESC
  """Ascending, NULLs first."""
  UNIQUE_AUTHOR_COUNT_ASC_NULLS_FIRST
  """Descending, NULLs last."""
  UNIQUE_AUTHOR_COUNT_DESC_NULLS_LAST
}

type ForumMinAggregate {
  id: UUID
  name: String
  archivedAt: Datetime
}

type ForumMaxAggregate {
  id: UUID
  name: String
  archivedAt: Datetime
}

type ForumDistinctCountAggregate {
  id: Int
  name: Int
  archivedAt: Int
}

type ForumAggregates {
  min: ForumMinAggregate
  max: ForumMaxAggregate
  """Number of distinct non-null values."""
  distinctCount: ForumDistinctCountAggregate
}

"""What `Forum` rows are grouped by: a column, or a date or timestamp truncated to a unit of time."""
enum ForumGroupBy {
  ID
  NAME
  ARCHIVED_AT
  ARCHIVED_AT_TRUNCATED_TO_MINUTE
  ARCHIVED_AT_TRUNCATED_TO_HOUR
  ARCHIVED_AT_TRUNCATED_TO_DAY
  ARCHIVED_AT_TRUNCATED_TO_WEEK
  ARCHIVED_AT_TRUNCATED_TO_MONTH
  ARCHIVED_AT_TRUNCATED_TO_QUARTER
  ARCHIVED_AT_TRUNCATED_TO_YEAR
  ARCHIVED_AT_BINNED
}

"""Aggregates of the `Forum` rows sharing the same `groupBy` values."""
type ForumAggregateGroup {
  """The group's values, in `groupBy` order."""
  keys: [JSON]!
  count: Int!
  min: ForumMinAggregate
  max: ForumMaxAggregate
  """Number of distinct non-null values."""
  distinctCount: ForumDistinctCountAggregate
}

"""Conditions groups must meet, all of them."""
input ForumHavingInput {
  count: IntFilter
}

type ForumEdge {
  cursor: String!
  node: Forum!
  """Position of the row among all matching rows in the connection's order (1 for the first), counting those before this page."""
  rowNumber("""Numbered (or summed) within groups of rows sharing these values.""" partitionBy: [ForumGroupBy!]): Int!
  """Rank of the row in the connection's order (rows with equal sort values share it, leaving gaps)."""
  rank("""Numbered (or summed) within groups of rows sharing these values.""" partitionBy: [ForumGroupBy!]): Int!
  denseRank("""Numbered (or summed) within groups of rows sharing these values.""" partitionBy: [ForumGroupBy!]): Int!
  """Relative rank, from 0 (first) to 1 (last)."""
  percentRank("""Numbered (or summed) within groups of rows sharing these values.""" partitionBy: [ForumGroupBy!]): Float!
}

type ForumConnection {
  edges: [ForumEdge!]!
  nodes: [Forum!]!
  pageInfo: PageInfo!
  """Number of matching rows (before paging). With `estimate`, the planner's estimate instead, from table statistics, or `EXPLAIN` for filtered rows: cheap on large tables, approximate (connections of a parent row always count exactly). With `exactBelow` too, the rows are counted exactly when the estimate is at most that many (an exact total for a small result, an estimate for a large one)."""
  totalCount(estimate: Boolean = false, exactBelow: Int): Int!
  aggregates("""Only rows matching it are aggregated (the connection's own filter applies too).""" filter: ForumFilter): ForumAggregates
  """Aggregates of each group of the rows (before paging), ordered by its keys."""
  groupedAggregates(groupBy: [ForumGroupBy!]!, having: ForumHavingInput, """Time zone dates and times are truncated in (e.g. `Europe/Paris`); the session's by default.""" timeZone: String, """Width of `_BINNED` groups, e.g. `PT15M`.""" binWidth: Interval, """Where `_BINNED` groups start (2000-01-01 by default).""" binOrigin: Datetime, """Include the empty groups between the first and the last (one truncated or binned key).""" fillGaps: Boolean = false): [ForumAggregateGroup!]!
}

input MessageCondition {
  id: UUID
  forumId: UUID
  authorId: UUID
  body: String
  featured: Boolean
  createdAt: Datetime
  archivedAt: Datetime
}

input MessageFilter {
  and: [MessageFilter!]
  or: [MessageFilter!]
  not: MessageFilter
  id: UUIDFilter
  forumId: UUIDFilter
  authorId: UUIDFilter
  body: StringFilter
  featured: BooleanFilter
  createdAt: DatetimeFilter
  archivedAt: DatetimeFilter
  author: UserFilter
  user: UserFilter
  forum: ForumFilter
}

