"""A range of `Int` values. A missing bound is unbounded."""
type IntRange {
  start: IntRangeBound
  end: IntRangeBound
  """Contains no value (both bounds are then null)."""
  isEmpty: Boolean!
}

type IntRangeBound {
  value: Int!
  inclusive: Boolean!
}

"""A range of `Int` values: a missing bound is unbounded; `start` is inclusive and `end` exclusive unless `inclusive` says otherwise."""
input IntRangeInput {
  start: IntRangeBoundInput
  end: IntRangeBoundInput
}

input IntRangeBoundInput {
  value: Int!
  inclusive: Boolean
}

