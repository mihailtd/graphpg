  isNull: Boolean
  equalTo: IntRangeInput
  notEqualTo: IntRangeInput
  """Contains this value."""
  contains: Int
  """Lies within this range."""
  containedBy: IntRangeInput
  overlaps: IntRangeInput
  strictlyLeftOf: IntRangeInput
  strictlyRightOf: IntRangeInput
  adjacentTo: IntRangeInput
}

