"""Any JSON value."""
scalar JSON

"""A 64-bit integer, as a string (JSON numbers are only exact up to 2^53). Input also takes an integer number."""
scalar BigInt

"""An arbitrary-precision decimal number, as a string, e.g. `12.50`. Input also takes a number."""
scalar Decimal

"""A point in time in ISO 8601 format with a UTC offset, e.g. `2024-05-01T12:30:00+00:00`. Input without an offset is in the server's time zone."""
scalar Datetime

"""A date and time of day without a time zone, in ISO 8601 format, e.g. `2024-05-01T12:30:00`."""
scalar LocalDatetime

"""A calendar date in ISO 8601 format, e.g. `2024-05-01`."""
scalar Date

"""A time of day in ISO 8601 format, e.g. `12:30:00`."""
scalar Time

"""A time of day with a UTC offset, e.g. `12:30:00+02`."""
scalar TimeTz

"""A duration in ISO 8601 format, e.g. `P1DT2H30M` (1 day, 2 hours and 30 minutes)."""
scalar Interval

"""A universally unique identifier, e.g. `a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11`."""
scalar UUID

"""Binary data, base64-encoded (RFC 4648, with padding)."""
scalar Base64

"""An IPv4 or IPv6 host address, optionally with a network prefix length, e.g. `192.168.0.1/24`."""
scalar InternetAddress

"""An IPv4 or IPv6 network, e.g. `192.168.0.0/24` (no bits set after the prefix)."""
scalar CidrAddress

"""A MAC address of 6 (or, for `macaddr8`, 8) bytes, e.g. `08:00:2b:01:02:03`."""
scalar MacAddress

"""A geometry as a GeoJSON geometry object (RFC 7946), e.g. `{"type": "Point", "coordinates": [2.35, 48.85]}`: longitude, then latitude, in WGS 84 unless the column says otherwise."""
scalar GeoJSON

interface Node {
  id: ID!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

"""What the database enforces on a value, in the keywords of JSON Schema (and so of the OpenAPI document): a `CHECK` on the column, or its `varchar(n)` length. Documentation for clients and code generators; the database checks every write."""
directive @constraint(minimum: Float, maximum: Float, exclusiveMinimum: Float, exclusiveMaximum: Float, multipleOf: Float, minLength: Int, maxLength: Int, pattern: String, minItems: Int, maxItems: Int) on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

directive @defer(label: String, if: Boolean = true) on FRAGMENT_SPREAD | INLINE_FRAGMENT

directive @stream(label: String, initialCount: Int = 0, if: Boolean = true) on FIELD

