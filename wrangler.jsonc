{
  "name": "graphpg",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./packages/website/src/.vitepress/dist",
    "not_found_handling": "404-page"
  },
  "previews": {},
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
