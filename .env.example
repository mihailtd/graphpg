# Secrets loaded from the environment or .env.
# Non-secret settings belong in graphpg.yaml.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/graphpg

# Optional read replica connection URLs (comma-separated):
# DATABASE_REPLICA_URLS=postgres://user:pass@replica1:5432/graphpg,postgres://user:pass@replica2:5432/graphpg

# Optional HMAC-SHA256 secret for JWT verification:
# AUTH_JWT_SECRET=your-secret-key-at-least-32-chars
