{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "e2e/**",
      "packages/**",
      "!**/node_modules",
      "!e2e/drizzle",
      "!packages/website/src/.vitepress/cache",
      "!packages/website/src/.vitepress/dist",
      "!packages/website/src/.vitepress/release.json",
      "!packages/website/.assets-unused",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" }
        }
      }
    }
  ]
}
